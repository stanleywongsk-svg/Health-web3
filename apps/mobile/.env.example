# Explicit real-native environment. Never set a service-role key here.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_DATA_MODE=real
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Must match the Supabase origin above. On a real iPhone use your development computer LAN IP.
EXPO_PUBLIC_CORE_API_URL=http://127.0.0.1:54321/functions/v1/core
