# Copy to supabase/functions/core/.env.local; never commit its contents.
# Supabase CLI injects SUPABASE_URL and SUPABASE_ANON_KEY for functions serve.
HEALTHLOOP_ENV=development
HEALTHLOOP_BUILD_MODE=demo
HEALTHLOOP_PROJECT_LABEL=healthloop-local-dev
# Exact origins, no wildcard. Native requests omit Origin.
HEALTHLOOP_ALLOWED_ORIGINS=http://localhost:8081
